{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar SQL Studio",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/gui.ps1",
                "-Modo", "compilar"
            ],
            "osx": {
                "command": "/bin/bash",
                "args": ["${workspaceFolder}/gui.sh", "compilar"]
            },
            "linux": {
                "command": "/bin/bash",
                "args": ["${workspaceFolder}/gui.sh", "compilar"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": [],
            "group": {"kind": "build", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "shared", "clear": true}
        }
    ]
}
